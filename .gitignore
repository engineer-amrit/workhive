# Monrorepo .gitignore - covers common monorepo files (Node, JS toolchains, IDEs, OS files, caches, build outputs)

### OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

### Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-debug-*.log*
lerna-debug.log*
*.log

### Environment / secrets
.env
.env.local
.env.*.local
.env.*.secret
local.env
.secret
secrets.json

### Node / JS / monorepo
node_modules/
**/node_modules/
.pnpm-store/
.pnpm/
package-lock.json.tmp
npm-packages-offline-cache/
yarn-error.log
.yarn/*
!.yarn/releases
!.yarn/patches
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# Monorepo package build outputs
dist/
**/dist/
build/
**/build/
out/
**/out/
lib/
**/lib/
bin/
**/bin/

# Caches
.cache/
**/.cache/
.npm/
.next/
.next/cache/
.nuxt/
.nuxt/dist/
.cache-loader/
.parcel-cache/
.storybook/build/
.cache/storybook/
.cache/babel-loader/
.eslintcache
.vscode/.history
.vite

# Tool-specific
coverage/
coverage-final.json
.nyc_output/
jest-cache/
jest-report/
test-results/
tsconfig.tsbuildinfo
.rpt2_cache/
.rollup.cache
parcel-cache/
.svelte-kit/

# TypeScript & transpilation artifacts
*.tsbuildinfo
*.d.ts.map

# Build tools / bundlers
.embroider-cache/
.cache/parcel/
.cache/esbuild/

# Frameworks / runtimes
.next/
out/
public/.cache
/.vercel/
.vercel/output/
.now/
.serverless/
.next-storybook/

# CI / temporary files
*.tmp
*.temp
tmp/
temp/

# IDEs and editors
.vscode/
.history/
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace

# JetBrains
.idea/
*.iml
out/

# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates

# macOS / Thumbnails
.DS_Store
.AppleDouble
.LSOverride

# Misc
Thumbs.db
*.swp
*.lock
*.bak
*.orig

# Optional: ignore per-package lockfiles? (usually you keep lockfiles in VCS)
# Uncomment to ignore pnpm/yarn workspace lockfiles if desired:
# pnpm-lock.yaml
# yarn.lock

# Local build/rush/pnpm common dirs (if using Rush)
common/temp/
common/config/rush/telemetry.json

# Nx / Turborepo
.nx/
.turbo/
.turborepo/
.cache/turbo/

# End